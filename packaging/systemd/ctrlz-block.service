# The branded block page (p4b-proxy 10.2). A process of its own because the proxy
# parses every hostile ClientHello and so must not hold a key that can sign for any
# name. It serves from unix sockets only: serve.sock for the proxy, agent.sock for
# the agent, both below /run/ctrlz-block.
[Unit]
Description=Ctrl Z block page
After=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ctrlz-block
Group=ctrlz-block
ExecStart=/usr/local/bin/ctrlz-node block
Restart=always
RestartSec=2s
LimitCORE=0
# The connections of 12 (2048 and room) at 128 KiB, the pages, the keys and leaves.
MemoryMax=512M
OOMScoreAdjust=500
ReadWritePaths=/run/ctrlz-block

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
# Nothing of ours is readable (5.1): the node's configuration and store are hidden,
# so a parser bug here shows an attacker no address and no topology.
TemporaryFileSystem=/etc/ctrlz:ro
InaccessiblePaths=/var/lib/ctrlz -/run/ctrlz
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
