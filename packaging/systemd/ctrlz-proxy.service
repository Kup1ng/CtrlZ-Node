# The proxy role (p4b-proxy 5.1): ports 80 and 443 on PROXY_IP, sniff, SOCKS to the
# active Xray slot, splice. It holds no key, no policy and no Grant, and reads no file
# of ours: its only inputs are proxy.sock (dns) and what clients send. It binds
# nothing until dns has sent its config over that socket.
[Unit]
Description=Ctrl Z proxy
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ctrlz-proxy
Group=ctrlz-proxy
ExecStart=/usr/local/bin/ctrlz-node proxy
Restart=always
RestartSec=2s
LimitCORE=0
# One descriptor for each client and one for each SOCKS leg (12: 30,000 connections).
LimitNOFILE=524288
# The socket memory of 12 is counted in this limit; the proxy trims stalled
# connections before it is reached (5.4).
MemoryMax=2G
# Under memory pressure the proxy and the slots go before DNS (5.4).
OOMScoreAdjust=500
Environment=GODEBUG=multipathtcp=0

CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
NoNewPrivileges=yes
ProtectSystem=strict
# Nothing of ours is readable (5.1): the node's configuration and store are hidden,
# so a parser bug here shows an attacker no address and no topology.
TemporaryFileSystem=/etc/ctrlz:ro
InaccessiblePaths=/var/lib/ctrlz -/run/ctrlz
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077
# No name, address or source is ever written; the output is the journal's.

[Install]
WantedBy=multi-user.target
