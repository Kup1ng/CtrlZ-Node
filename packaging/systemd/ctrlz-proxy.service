# The proxy role: idle in P4, binds nothing and holds nothing (p4-nodes 7.1). The
# unit exists so the install and the sandbox are the final ones when P4b fills it;
# P4b adds the capabilities and sockets it needs here.
[Unit]
Description=Ctrl Z proxy (idle)
After=network-online.target
Wants=network-online.target
StartLimitIntervalSec=0

[Service]
Type=simple
User=ctrlz-proxy
Group=ctrlz-proxy
ExecStart=/usr/local/bin/ctrlz-node proxy
Restart=always
RestartSec=5s
LimitCORE=0

CapabilityBoundingSet=
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=multi-user.target
